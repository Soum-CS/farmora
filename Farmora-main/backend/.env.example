# Backend environment variables
PORT=5000
MONGO_URI=mongodb://localhost:27017/farmora
JWT_SECRET=change_this_to_a_strong_secret

# Optional: enable live weather using OpenWeatherMap-compatible endpoint.
# If omitted, weather data is read from MongoDB seeded data.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather
